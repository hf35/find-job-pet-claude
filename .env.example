# Port the HTTP server listens on
PORT=8844
# Bind address (0.0.0.0 inside Docker; the compose file publishes it on 127.0.0.1 only)
HOST=0.0.0.0
# Directory with the built web UI (default: ../web/dist relative to the server build)
# WEB_DIST=
# SQLite file (Docker image sets /data/app.sqlite; in dev defaults to ./data/app.sqlite relative to server/)
# DATABASE_PATH=./data/app.sqlite

# --- Authentication ---
ADMIN_USERNAME=admin
# bcrypt hash of the password: run `npm run hash-password` and paste the output.
# Keep the single quotes - the hash contains "$" characters.
ADMIN_PASSWORD_HASH=
# Random string, at least 32 chars: `openssl rand -hex 32`. Changing it logs everybody out.
SESSION_SECRET=
# Session lifetime in days
# SESSION_TTL_DAYS=30
# Secure cookie flag; defaults to true when NODE_ENV=production. Set to false only for plain-HTTP testing.
# COOKIE_SECURE=true
